# Admin
# Email du compte admin (utilisé à la connexion)
ADMIN_EMAIL=ton-email@example.com
# Hash PBKDF2 du mot de passe admin — NE PAS mettre le mot de passe en clair ici !
# Format : base64 de JSON {"hash":"<hex>","salt":"<hex>"}
# Génère-le avec :  node scripts/hash-password.mjs "VotreMotDePasse"
ADMIN_PASSWORD_HASH=<coller-ici-le-resultat-de-hash-password>

# Secret utilisé pour signer les cookies de session (change-le en production)
AUTH_SECRET=change-this-in-production-please

# Base de données Admin (chemin local, fichier JSON — fallback si Supabase absent)
ADMIN_DATA_PATH=./data
ADMIN_DATA_FILE=portfolio.json

# Session cookie admin
ADMIN_SESSION_COOKIE=admin_session

# Contact
CONTACT_EMAIL=
RESEND_API_KEY=

# Supabase (optionnel — si absent, fallback automatique sur le JSON local)
# Crée les tables avec : supabase/schema.sql
# Migre les données avec : npx tsx scripts/migrate-to-supabase.ts
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
